OR=function(matrix,adjust=TRUE){
if(adjust==TRUE){mat=matrix+0.5}
OR=(mat[1,1]*mat[2,2])/(mat[1,2]*mat[2,1])
return(OR)
}
apply(MIOC,3,OR)
mantelhaen.test(MIOC)
